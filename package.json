{
  "name": "rydex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n web,socket -c cyan,magenta \"npm:dev:web\" \"npm:dev:socket\"",
    "dev:web": "npm run dev -w @rydex/frontend",
    "dev:socket": "npm run dev -w @rydex/backend",
    "build": "npm run build -w @rydex/frontend",
    "start": "npm run start -w @rydex/frontend",
    "socket": "npm run socket -w @rydex/backend",
    "seed": "npm run seed -w @rydex/backend",
    "create-admin": "npm run create-admin -w @rydex/backend",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck -w @rydex/shared && npm run typecheck -w @rydex/backend && npm run typecheck -w @rydex/frontend"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0"
  }
}
